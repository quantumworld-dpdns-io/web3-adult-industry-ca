{
  "type": "record",
  "name": "CredentialEvent",
  "namespace": "ca.audit",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["ISSUED", "VERIFIED", "REVOKED", "EXPIRED"]}},
    {"name": "credential_id", "type": "string"},
    {"name": "issuer_did", "type": "string"},
    {"name": "subject_did", "type": "string"},
    {"name": "credential_type", "type": "string"},
    {"name": "timestamp", "type": "long", "logicalType": "timestamp-millis"},
    {"name": "metadata", "type": ["null", "string"], "default": null}
  ]
}
