# =============================================================================
# Web3 Adult Industry Certification Authority - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running the stack.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------
# API_KEY:  Secret key used to authenticate API-to-API and dashboard-to-API
#           requests. Must be a cryptographically random string (min 32 chars).
API_KEY=your-api-key-here

# JWT_SECRET:  HMAC signing secret for issued JWT tokens. Must be at least
#              256 bits (32 bytes) of cryptographically random data.
JWT_SECRET=your-jwt-secret-here

# JWT_ALGORITHM:  Signing algorithm for JWTs. Supported: HS256, HS384, HS512.
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES:  Lifetime of issued access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# REFRESH_TOKEN_EXPIRE_DAYS:  Lifetime of refresh tokens in days.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# DATABASE_URL:  PostgreSQL connection string (asyncpg driver for FastAPI).
#                Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ca:ca_password@localhost:5432/ca

# REDIS_URL:  Redis connection string for caching, rate limiting, and queues.
#             Format: redis://host:port
REDIS_URL=redis://localhost:6379

# DUCKDB_PATH:  File path for DuckDB analytics database (embedded OLAP).
DUCKDB_PATH=./data/analytics.duckdb

# ---------------------------------------------------------------------------
# OpenTelemetry Configuration
# ---------------------------------------------------------------------------
# OTLP_ENDPOINT:  gRPC endpoint for the OpenTelemetry collector.
#                 Format: http://host:port
OTLP_ENDPOINT=http://localhost:4317

# OTLP_SERVICE_NAME:  Service name reported to the OTel collector.
OTLP_SERVICE_NAME=ca-api

# OTLP_HEADERS:  Optional headers sent with every OTel export (e.g., auth).
OTLP_HEADERS=

# ---------------------------------------------------------------------------
# Dashboard (Next.js) Configuration
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL:  Public-facing URL of the API that the browser uses.
#                       Must be set at build time for Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NEXT_PUBLIC_API_KEY:  Public API key included in dashboard requests.
NEXT_PUBLIC_API_KEY=your-api-key-here

# NEXTAUTH_URL:  Full URL of the dashboard for NextAuth callbacks.
NEXTAUTH_URL=http://localhost:3000

# NEXTAUTH_SECRET:  Encryption secret for NextAuth sessions.
NEXTAUTH_SECRET=your-nextauth-secret-here

# ---------------------------------------------------------------------------
# Smart Contract Configuration
# ---------------------------------------------------------------------------
# SOLANA_RPC_URL:  RPC endpoint for Solana contract interactions.
#                  Use devnet for development, mainnet-beta for production.
SOLANA_RPC_URL=https://api.devnet.solana.com

# EVM_RPC_URL:  RPC endpoint for EVM-compatible chain interactions.
#               Use testnet (Sepolia, Goerli) for development.
EVM_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# EVM_PRIVATE_KEY:  Private key for signing EVM contract transactions.
#                   NEVER commit this to version control.
EVM_PRIVATE_KEY=your-evm-private-key

# SOLANA_PRIVATE_KEY:  Private key (JSON array or base58) for signing Solana
#                      transactions. NEVER commit this to version control.
SOLANA_PRIVATE_KEY=your-solana-private-key

# CONTRACT_REGISTRY_ADDRESS:  Deployed address of the on-chain registry
#                             contract used by the CA system.
CONTRACT_REGISTRY_ADDRESS=

# ---------------------------------------------------------------------------
# Rate Limiting & Security
# ---------------------------------------------------------------------------
# RATE_LIMIT_PER_MINUTE:  Maximum number of API requests per client per minute.
RATE_LIMIT_PER_MINUTE=60

# RATE_LIMIT_BURST:  Maximum burst size for the rate limiter token bucket.
RATE_LIMIT_BURST=100

# CORS_ORIGINS:  Comma-separated list of origins allowed by CORS.
#                Use wildcards only in development.
CORS_ORIGINS=http://localhost:3000

# LOG_LEVEL:  Application log level. One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
