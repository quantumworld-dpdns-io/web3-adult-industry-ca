FROM rust:1.80-slim AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY ca-core/ ./ca-core/
COPY ca-cli/ ./ca-cli/
RUN cargo build --release --bin ca-cli

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/ca-cli /usr/local/bin/ca-cli

ENTRYPOINT ["ca-cli"]
